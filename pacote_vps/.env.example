DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_do_banco"
DATABASE_SSL="false"
JWT_SECRET="troque_por_uma_chave_segura"
# Porta do backend. O outro sistema ja usa a 3000, entao aqui usamos 3001.
# Se a 3001 tambem estiver ocupada, escolha outra livre (ex: 3002, 4000, 8080).
PORT=3001
PUBLIC_URL="http://seu-dominio-ou-ip"

# Banco Inter OAuth com mTLS.
# Informe a URL COMPLETA do endpoint de token fornecida pelo Banco Inter.
INTER_TOKEN_URL=""
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""

# Use caminhos absolutos e mantenha chave/certificado fora da pasta pública.
INTER_CERT_PATH="/etc/controle-comissoes/inter/certificado.crt"
INTER_KEY_PATH="/etc/controle-comissoes/inter/chave-privada.key"
# Preencha somente se a chave privada for criptografada.
INTER_KEY_PASSPHRASE=""

INTER_HTTP_TIMEOUT_MS=10000
INTER_MAX_503_RETRIES=1
INTER_RETRY_DELAY_MS=750
