# Conexão com o SEU PostgreSQL (na VPS)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/ctrlcontratos"
# Se o Postgres exigir SSL (ex.: provedor gerenciado), mude para "true"
DATABASE_SSL="false"

# Segredo para assinar os tokens de sessão (JWT). TROQUE por um valor aleatório longo.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"

# Porta em que a API/servidor vai rodar
PORT=3001

# URL pública do servidor (usada nos links de logo e reset de senha).
# Ex.: https://comissoes.seudominio.com  — deixe vazio para detectar automaticamente.
PUBLIC_URL=""

# Banco Inter OAuth com mTLS.
# Informe a URL COMPLETA do endpoint de token fornecida pelo Banco Inter.
INTER_TOKEN_URL=""
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""

# Use caminhos absolutos. Não coloque certificado ou chave dentro do repositório.
INTER_CERT_PATH="/etc/controle-comissoes/inter/certificado.crt"
INTER_KEY_PATH="/etc/controle-comissoes/inter/chave-privada.key"
# Preencha somente se a chave privada for criptografada.
INTER_KEY_PASSPHRASE=""

INTER_HTTP_TIMEOUT_MS=10000
INTER_MAX_503_RETRIES=1
INTER_RETRY_DELAY_MS=750
